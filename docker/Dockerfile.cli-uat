FROM node:22-bookworm-slim

ARG CLAUDE_VERSION=2.1.259
ARG SOURCE_COMMIT=unknown
ARG COPILOT_VERSION=1.0.82
ARG OPENCODE_VERSION=1.18.25
ARG CODEX_VERSION=0.151.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BRAINS_RENDERER_COMMIT="${SOURCE_COMMIT}" \
    PATH="/opt/brains-venv/bin:${PATH}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git python3 python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g \
      "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
      "@github/copilot@${COPILOT_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}"

WORKDIR /opt/brains
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python3 -m venv /opt/brains-venv \
 && /opt/brains-venv/bin/pip install .

COPY tests/uat/real_cli_actor.py /opt/uat/real_cli_actor.py
COPY tests/uat/claude_wakeup_probe.py /opt/uat/claude_wakeup_probe.py

RUN mkdir -p /workspace /run/credentials /opt/uat \
 && chown -R node:node /workspace /opt/uat

USER node
WORKDIR /workspace
CMD ["sleep", "infinity"]
