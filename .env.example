# Optional Brains environment overrides. Keep real configuration outside the repository.

# State and SQLite storage. Relative database URLs can fragment Workspace state, so the
# default per-user state directory is recommended.
# BRAINS_STATE_DIR=/path/to/private/brains-state
# BRAINS_DB_URL=sqlite:////path/to/private/brains-state/brains.db

# Authentication. Leave the API key unset to use the generated local admin key.
BRAINS_API_KEY=
BRAINS_ALLOW_UNAUTHENTICATED_API=false

# Local configuration and default Workspace.
BRAINS_CONFIG=
BRAINS_WORKSPACE=.
