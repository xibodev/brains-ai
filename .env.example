# Brains environment overrides.
#
# All values are optional. The defaults below are what brains uses when a
# variable is unset. Copy this file to `.env` (auto-loaded by pydantic-settings)
# or set the variables directly in your shell.

# --- Storage -----------------------------------------------------------------
# Unset = the shared per-machine DB at ~/.brains/brains.db (honours
# BRAINS_STATE_DIR). Override only if you really want a private brain — the
# CLI, the SSE server, and stdio MCP children all key off this URL, so a
# CWD-relative or per-project override silently fragments your sessions
# across multiple databases. The historical default ``sqlite:///brains.db``
# is auto-canonicalised to the shared path so legacy ``.env`` files keep
# working.
# BRAINS_DB_URL=sqlite:///C:/Users/you/.brains/brains.db

# --- Authentication ----------------------------------------------------------
# Leave BRAINS_API_KEY EMPTY (or unset) to use the persisted admin key at
# ~/.brains/admin-key (auto-generated on first run by `brains init` /
# `brains serve`). Setting a value here overrides the persisted key entirely.
# Manage the persisted key with:
#   brains admin-key show --reveal
#   brains admin-key rotate
#   brains admin-key path
BRAINS_API_KEY=
BRAINS_ALLOW_UNAUTHENTICATED_API=false

# --- Workspaces / config -----------------------------------------------------
BRAINS_CONFIG=
BRAINS_WORKSPACE=.
BRAINS_DOCS_STALE_DAYS=45
BRAINS_REPO_INDEX_MAX_FILE_SIZE=512000
BRAINS_FRESHNESS_TIMEOUT_SECONDS=5

# --- Providers ---------------------------------------------------------------
BRAINS_OLLAMA_BASE_URL=http://127.0.0.1:11434
BRAINS_OLLAMA_TIMEOUT_SECONDS=30
