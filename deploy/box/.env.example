# Brains sidekick — box deploy env. Copy to deploy/box/.env and fill in.
# NEVER commit the filled .env. Every value here is a secret or host-specific.

# --- database ---
POSTGRES_PASSWORD=change-me-strong

# --- control-plane auth (bearer) ---
# Gateway + dashboard require this; generate with: openssl rand -hex 32
BRAINS_API_KEY=
# Relay endpoints (/relay/reply, /relay/triage) require this; they 503 when unset.
# generate with: openssl rand -hex 32
BRAINS_RELAY_TOKEN=

# --- the brains image ---
# After the PyPI release, build a thin image FROM python that does
# `pip install brains-ai==<version>` + installs the agent CLIs (copilot/claude/codex),
# and set BRAINS_IMAGE to it. Until then, a locally-built image.
BRAINS_IMAGE=brains-ai:latest

# --- executor user (the egress lock polices this uid; see scripts/gate-egress-lock.sh) ---
BRAINS_EXEC_UID=10001
BRAINS_EXEC_GID=10001

# --- host paths ---
BRAINS_WORKSPACES=./workspaces      # repos the sidekick is allowed to operate on
BRAINS_SECRETS_DIR=./secrets        # scoped, read-only creds mounted at /run/secrets

# --- WhatsApp bridge (optional; leave blank to disable) ---
BRAINS_WHATSAPP_TOKEN=
BRAINS_WHATSAPP_PHONE_ID=
BRAINS_WHATSAPP_RECIPIENT=
